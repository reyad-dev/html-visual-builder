  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/contract-export-format">
    <rdf:type rdf:resource="urn:ontolink:Contract" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/06_IMPORT_EXPORT.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:05.897107+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Valid HTML5 doctype, UTF-8 charset, responsive viewport meta, inline sanitized CSS, clean body markup.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standalone Export Contract</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-06-import-export" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/contract-saved-project-schema">
    <rdf:type rdf:resource="urn:ontolink:Contract" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/07_DATA_MODEL.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:05.740727+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Schema v1: id, name, createdAt, updatedAt, sourceMeta, editorProjectData.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SavedProject Data Contract</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-07-data-model" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/contract-security-policy">
    <rdf:type rdf:resource="urn:ontolink:Contract" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/09_SECURITY.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:05.544415+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Never execute imported JavaScript or fetch remote scripts. Strip script tags, javascript: URI schemes, and inline event handlers.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Untrusted Code Execution Prohibition</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-09-security" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/contract-tech-stack">
    <rdf:type rdf:resource="urn:ontolink:Contract" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/03_TECH_STACK.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:05.183660+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">React 18 + TypeScript (strict) + Vite + GrapesJS Core + DOMPurify + Vitest + Playwright.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Approved Technology Stack</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-03-tech-stack" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/contract-ui-engine-boundary">
    <rdf:type rdf:resource="urn:ontolink:Contract" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AGENTS.md &amp; docs/04_ARCHITECTURE.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:05.380608+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GrapesJS owns component tree, styles, canvas selection, and undo/redo. React/Zustand owns only UI shell state. Never duplicate GrapesJS model in React state.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UI and Editor Engine Boundary</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/artifact-spec-agents" />
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-04-architecture" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/dec-browser-storage">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/03_TECH_STACK.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:06.465492+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use browser localStorage / IndexedDB abstraction interface for MVP project saving without remote server backend.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Browser Storage for MVP</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/dec-dompurify-sanitizer">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/09_SECURITY.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:06.265814+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use DOMPurify with strict static document configuration rather than regex-based parsing.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DOMPurify Sanitization</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/dec-grapesjs-core">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/14_DECISIONS_AND_TROUBLESHOOTING.md</ol:basis>

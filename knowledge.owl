  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/req-client-only-mvp">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/02_SCOPE_AND_NON_GOALS.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:05.024411+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero backend, zero cloud database, zero external authentication, zero AI generation in MVP scope.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Client-Side Only MVP Scope</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-02-scope" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/req-editor-engine-grapesjs">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/03_TECH_STACK.md and docs/04_ARCHITECTURE.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:04.264445+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use GrapesJS Core as the visual canvas and component tree engine behind a typed adapter layer.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GrapesJS Core Integration</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-03-tech-stack" />
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-04-architecture" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/req-json-persistence">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/07_DATA_MODEL.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:04.537884+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Persist project state as GrapesJS Project Data JSON in browser local storage, not plain HTML/CSS strings.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Canonical JSON Persistence</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-07-data-model" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/req-secure-import">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/06_IMPORT_EXPORT.md and docs/09_SECURITY.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:04.366172+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Import untrusted HTML via browser DOMParser, strip script tags and inline executable event handlers via DOMPurify before canvas load.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Secure HTML Import Pipeline</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-06-import-export" />
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-09-security" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/req-standalone-export">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/06_IMPORT_EXPORT.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:04.767670+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generate standalone single-file HTML/CSS document without builder runtime dependencies or tracking scripts.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clean Standalone HTML Export</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:html-visual-builder/doc-06-import-export" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:html-visual-builder/req-visual-builder-core">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">docs/01_PRODUCT_SPEC.md</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:html-visual-builder" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T17:18:04.164230+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Browser-based visual builder for importing, editing, and exporting static HTML/CSS with mouse-driven controls and block palette.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Static HTML/CSS Visual Canvas</ol:title>

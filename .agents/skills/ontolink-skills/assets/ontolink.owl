    <ol:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ol:order>
    <ol:requiredKind>contracts</ol:requiredKind>
    <ol:routesTo rdf:resource="urn:ontolink:skill-ontolink-architecture"/>
    <ol:usesSkill rdf:resource="urn:ontolink:skill-nexus-full-stack"/>
    <ol:usesSkill rdf:resource="urn:ontolink:skill-template-architecture"/>

    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>LikelihoodAssessment</rdfs:label>
    <rdfs:comment>Event probability or qualified estimate with explicit event, horizon, method and calibration status; absence of a value means unknown.</rdfs:comment>
  </rdf:Description>
